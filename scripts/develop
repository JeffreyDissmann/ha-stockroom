#!/usr/bin/env bash
# Run Home Assistant (2026.3+) from the Python 3.14 runtime environment,
# reachable at http://localhost:8123, with this integration loaded.

set -e

cd "$(dirname "$0")/.."

# Ensure the runtime environment exists (provisions it on first run).
if [[ ! -x ".venv314/bin/hass" ]]; then
    echo "Runtime environment not found — running scripts/setup..."
    scripts/setup
fi

if [[ ! -d "${PWD}/config" ]]; then
    mkdir -p "${PWD}/config"
    .venv314/bin/hass --config "${PWD}/config" --script ensure_config
fi

# Symlink the integration into the HA config so it loads as a custom component.
mkdir -p "${PWD}/config/custom_components"
if [[ ! -e "${PWD}/config/custom_components/stockroom" ]]; then
    ln -s "${PWD}/custom_components/stockroom" \
        "${PWD}/config/custom_components/stockroom"
fi

.venv314/bin/hass --config "${PWD}/config" --debug
